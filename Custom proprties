/* Custom properties er brugerdefinerede CSS-variabler, 
som gør det muligt at gemme værdier og genbruge dem flere steder i sin CSS. */

.html{
    --main-color: red;
    --general-margin:20px 0;
    --border-radius: 12px;
}


cards {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
gap: 24px;
max-width: 1100px;
margin: 40px auto;
.h2 {
font-size: 1.5rem;
margin: 24px 0 12px;
}
}
.p {
line-height: 1.6;
margin-bottom: 24px;
.card {
padding: 24px;
border: 1px solid #aaa;
border-radius: var(--border-radius);

}
}
.button {
padding: 12px 24px;
border: none;
border-radius: var(--border-radius);
cursor: pointer;
.card img {
width: 100%;
aspect-ratio: 3 / 2;
object-fit: cover;
border-radius: var(--border-radius);
}
}